# Required. run.bat generates a random value on first run. Never commit the real .env file.
SECRET_KEY=

# Display timezone. Data is always stored in UTC.
TIMEZONE=America/Sao_Paulo

# Local only by default. Keep 127.0.0.1 unless you know what you are doing.
HOST=127.0.0.1
PORT=5000

# Accesses ending within this many days are shown as "Expiring soon".
EXPIRING_DAYS=14

# CSV separator for exports. Use ; if Excel opens each row in a single column
# (common with Brazilian regional settings).
CSV_DELIMITER=,

# Duration warnings (days). A Critical or High access that lasts longer shows a warning.
# It never blocks anything.
CRITICAL_MAX_DAYS=30
HIGH_MAX_DAYS=90

# Optional. Separate key (at least 32 characters) for the audit log hash chain.
# Leave empty to derive it from SECRET_KEY. If you set it, keep it with your backups:
# without the same key the audit log integrity check cannot be done.
AUDIT_HASH_KEY=

# Show a reminder on the dashboard when the audit log was not verified for this many days (0 = off).
INTEGRITY_REMINDER_DAYS=30

# Idle timeout (minutes) and login protection.
IDLE_TIMEOUT_MINUTES=5
MIN_PASSWORD_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Set to true only when serving over HTTPS.
COOKIE_SECURE=false
